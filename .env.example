# All variables are optional. RepoScope runs fully deterministic without any of them.

# API port (default 8787)
# PORT=8787

# Optional: rewrite summary prose with an OpenAI-compatible endpoint (e.g. Ollama).
# Facts, nodes, edges, warnings and the health score are never produced by the model.
# REPOSCOPE_LLM_URL=http://localhost:11434/v1
# REPOSCOPE_LLM_MODEL=llama3.1
# REPOSCOPE_LLM_API_KEY=
